# Copy this file to .env and fill in your values. Never commit .env!
# Any OpenAI-compatible provider works. The model MUST support vision (images).

# --- Option 1: Google Gemini (free tier, recommended) -----------------------
# Get a free key at https://aistudio.google.com/apikey
BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
API_KEY=your-api-key-here
MODEL_NAME=gemini-3.5-flash

# --- Option 2: GitHub Models (free with a GitHub account) -------------------
# Create a fine-grained token with the "Models: read" permission.
# BASE_URL=https://models.github.ai/inference
# API_KEY=your-github-token-here
# MODEL_NAME=openai/gpt-4o-mini

# --- Option 3: Groq (free tier) ---------------------------------------------
# BASE_URL=https://api.groq.com/openai/v1
# API_KEY=your-groq-key-here
# MODEL_NAME=meta-llama/llama-4-scout-17b-16e-instruct

# --- Option 4: Ollama (runs locally, 100% free & private) -------------------
# Install Ollama, then: ollama pull qwen2.5vl:7b
# BASE_URL=http://localhost:11434/v1
# API_KEY=ollama
# MODEL_NAME=qwen2.5vl:7b

# --- Optional settings (defaults shown) -------------------------------------
# MAX_FILE_MB=10
# MAX_PDF_PAGES=5
# TOTALS_TOLERANCE=0.02
# LLM_TIMEOUT=60
# BATCH_CONCURRENCY=2
# RATE_LIMIT_RETRIES=2      # on "429 rate limit", wait as asked and retry
# RATE_LIMIT_MAX_WAIT=65    # max seconds to wait per retry
